# Robinhood OAuth credentials (never commit real values)
ROBINHOOD_CLIENT_ID=
ROBINHOOD_CLIENT_SECRET=
ROBINHOOD_ACCESS_TOKEN=
ROBINHOOD_REFRESH_TOKEN=

# MCP server URL (Robinhood hosted MCP endpoint)
ROBINHOOD_MCP_SERVER_URL=https://agent.robinhood.com/mcp/trading

# Paper trading mode (simulated trades, no real orders)
ROBINHOOD_PAPER_TRADING=false

# Enable crypto trading tools
ROBINHOOD_CRYPTO_ENABLED=false

# HTTP transport port (when using --transport=http)
ROBINHOOD_MCP_HTTP_PORT=3100

# Audit log path (trade requests are logged here; secrets are redacted)
ROBINHOOD_AUDIT_LOG_PATH=./logs/audit.log

# Rate limit: max requests per minute to Robinhood API
ROBINHOOD_RATE_LIMIT_PER_MINUTE=60
